# Server (server/.env) and Vercel (Environment Variables) configuration.
# Copy to server/.env for local development.

# Required — used to sign and verify JWTs. Use a long random string.
JWT_SECRET=

# Mongo connection string. Optional locally (defaults to mongodb://localhost:27017/resume-builder).
MONGODB_URI=mongodb://localhost:27017/resume-builder

# Optional — enables the AI features (extract keywords, auto-fill, resume chat).
# Get a key from https://build.nvidia.com/
NVIDIA_API_KEY=

# Optional — server listen port (default 3001).
PORT=3001
