# Server (server/.env) and Vercel (Environment Variables) configuration.
# Copy to server/.env for local development.

# Required — used to sign and verify JWTs. Use a long random string.
JWT_SECRET=

# Mongo connection string. Optional locally (defaults to mongodb://localhost:27017/resume-builder).
MONGODB_URI=mongodb://localhost:27017/resume-builder

# Optional — enables the AI features (extract keywords, auto-fill, resume chat).
# Get a key from https://build.nvidia.com/
NVIDIA_API_KEY=

# Optional — enables password reset / change confirmation emails.
# Get a key from https://resend.com/ (or leave blank: codes are logged to the server console).
RESEND_API_KEY=

# Optional — "From" address for outgoing emails. Must be a verified sender/domain on Resend.
EMAIL_FROM=Modular Resume Builder <onboarding@resend.dev>

# Optional — comma-separated list of allowed browser origins for the local
# Express server. Same-origin requests (Vercel, the Vite dev proxy) are
# unaffected. Defaults to the Vite dev servers.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional — server listen port (default 3001).
PORT=3001
